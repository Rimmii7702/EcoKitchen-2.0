{
  "experiment_version": "freshretailnet-lightgbm-validation-v1",
  "protocol": "validation-v1.json",
  "training_origins": {"first": "2024-04-16", "stride_days": 7},
  "pilot": {"pair_hash_modulus": 20, "pair_hash_remainder": 0},
  "candidate_iterations": [32, 64, 96],
  "selection_metric": "pooled_validation_wape_pct",
  "duckdb": {"memory_limit": "512MB", "threads": 2},
  "lightgbm": {
    "objective": "regression_l1",
    "device_type": "cpu",
    "deterministic": true,
    "force_col_wise": true,
    "num_threads": 4,
    "verbosity": -1,
    "seed": 42,
    "data_random_seed": 42,
    "learning_rate": 0.1,
    "num_leaves": 47,
    "max_bin": 63,
    "bin_construct_sample_cnt": 150000,
    "min_data_in_leaf": 100,
    "lambda_l2": 2.0,
    "cat_smooth": 20,
    "histogram_pool_size": 128
  }
}
