# syntax=docker/dockerfile:1
FROM node:24.22.2-bookworm-slim AS dashboard-build
WORKDIR /dashboard
COPY dashboard/package.json dashboard/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY dashboard/index.html dashboard/vite.config.js ./
COPY dashboard/src/ ./src/
RUN VITE_API_BASE_URL='' VITE_PUBLIC_DEMO=1 npm run build \
    && mkdir dist/notices \
    && for package in react react-dom lucide-react @fontsource-variable/dm-sans @fontsource-variable/manrope; do \
         cp "node_modules/$package/LICENSE" "dist/notices/${package##*/}.txt"; \
       done

FROM python:3.11.15-slim-bookworm
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 HOME=/tmp
WORKDIR /app
COPY requirements-deploy.lock ./
RUN apt-get update \
    && apt-get install -y --no-install-recommends nginx \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir --only-binary=:all: -c requirements-deploy.lock Flask Gunicorn SQLAlchemy python-dotenv \
    && pip check
COPY auth_store.py local_api.py reverse_proxy.py runtime_config.py security.py ./
COPY inventory_api.py inventory_context.py inventory_db.py inventory_service.py ./
COPY menu_snapshot.py recipe_inventory.py recommendations_api.py recommendations_service.py ./
COPY forecasting/__init__.py forecasting/retail_api.py forecasting/retail_benchmark.py ./forecasting/
COPY forecasting/results/freshretailnet-holdout-v1.json ./forecasting/results/
COPY data/fictional-menu.json ./data/
COPY tools/portfolio_demo.py ./tools/
COPY deploy/render_demo.py deploy/start_render.py deploy/nginx.render.conf deploy/gunicorn.conf.py ./deploy/
COPY --from=dashboard-build /dashboard/dist/ ./dashboard/dist/
USER 10001:10001
EXPOSE 10000
CMD ["python", "-m", "deploy.start_render"]
