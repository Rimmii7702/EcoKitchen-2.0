# Leave blank to run without Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_RECIPE_MODEL=gemini-3.5-flash-lite

# Uncomment this setting to generate to a private local file.
# RECOMMENDATIONS_FILE=recommendations.local.json

# Local inventory database. Relative paths resolve from the project root.
INVENTORY_DB_PATH=instance/inventory.sqlite3

# Optional comma-separated loopback browser origins for the local dashboard.
# INVENTORY_CORS_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:4173

# Local authentication. Create accounts with the interactive create-user command.
# ECOKITCHEN_AUTH_MODE=loopback
# ECOKITCHEN_AUTH_DB=instance/auth.sqlite3
# Optional in loopback mode. Generate a strong random key for persistent sessions.
# ECOKITCHEN_SECRET_KEY=
# HTTPS mode requires a strong key, exact HTTPS API origins and HTTPS-only CORS.
# ECOKITCHEN_HTTPS_HOSTS=

# Docker Compose requires a generated ECOKITCHEN_SECRET_KEY. Run it on loopback.
# ECOKITCHEN_PORT=8080
# ECOKITCHEN_DOCKER_NETWORK_PREFIX=172.30.96
# ECOKITCHEN_INSTALL_AI=0

# Optional versioned local forecast models
# FORECAST_DEMAND_ARTIFACT=instance/forecasting/demand-v1/model.json
# FORECAST_WASTE_SIM_ARTIFACT=instance/forecasting/waste-synthetic-v1/model.json
